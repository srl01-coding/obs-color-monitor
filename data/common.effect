uniform float4x4 ViewProj;
uniform texture2d image;

// HLG (Rec.2100) parameters, set from OBS video settings.
uniform float sdr_white_nits_over_maximum = 0.0203; // SDR white nits / 10000
uniform float hdr_lw = 1000.0;                      // HDR nominal peak nits
// Output normalisation: value written = code / 1023 (exact in a UNORM10 target).
uniform float y_scale = 0.85630498533;  // 876/1023 narrow, 1.0 full
uniform float y_offset = 0.06256109482; // 64/1023 narrow, 0.0 full
uniform float c_scale = 0.87585532746;  // 896/1023 narrow, 1.0 full

sampler_state cnv_sampler {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 PSConvertRGB_YUV601(VertInOut vert_in) : TARGET
{
	float4 rgb = image.Sample(cnv_sampler, vert_in.uv);
	float4 uv00;
	uv00.z = -0.147643 * rgb.x -0.289855 * rgb.y +0.437500 * rgb.z +0.5 - 1.0/256.0; // U
	uv00.y = +0.299000 * rgb.x +0.587000 * rgb.y +0.114000 * rgb.z; // Y
	uv00.x = +0.437500 * rgb.x -0.366351 * rgb.y -0.071147 * rgb.z +0.5; // V
	uv00.a = 1;
	return uv00;
}

float4 PSConvertRGB_YUV709(VertInOut vert_in) : TARGET
{
	float4 rgb = image.Sample(cnv_sampler, vert_in.uv);
	float4 uv00;
	uv00.z = -0.100643 * rgb.x -0.338571 * rgb.y +0.439216 * rgb.z +0.5 - 1.0/256.0; // U
	uv00.y = +0.212600 * rgb.x +0.715200 * rgb.y +0.072200 * rgb.z; // Y
	uv00.x = +0.439216 * rgb.x -0.398941 * rgb.y -0.040273 * rgb.z +0.5; // V
	uv00.a = 1;
	return uv00;
}

/*
 * HLG encoding copied from libobs/data/color.effect (OBS Studio, GPL-2.0-or-later)
 * so that the scope sees exactly the signal OBS itself encodes for a
 * Rec.2100 HLG output (see PS_P010_HLG_Y_709_2020 in format_conversion.effect).
 */
float3 rec709_to_rec2020(float3 v)
{
	float r = dot(v, float3(0.62740389593469903, 0.32928303837788370, 0.043313065687417225));
	float g = dot(v, float3(0.069097289358232075, 0.91954039507545871, 0.011362315566309178));
	float b = dot(v, float3(0.016391438875150280, 0.088013307877225749, 0.89559525324762401));
	return float3(r, g, b);
}

float linear_to_st2084_channel(float x)
{
	float c = pow(abs(x), 0.1593017578);
	return pow((0.8359375 + 18.8515625 * c) / (1. + 18.6875 * c), 78.84375);
}

float st2084_to_linear_channel(float u)
{
	float c = pow(abs(u), 1. / 78.84375);
	return pow(abs(max(c - 0.8359375, 0.) / (18.8515625 - 18.6875 * c)), 1. / 0.1593017578);
}

float eetf_0_Lmax(float maxRGB1_pq, float Lw, float Lmax)
{
	float Lw_pq = linear_to_st2084_channel(Lw / 10000.);
	float E1 = saturate(maxRGB1_pq / Lw_pq);
	float maxLum = linear_to_st2084_channel(Lmax / 10000.) / Lw_pq;
	float KS = (1.5 * maxLum) - 0.5;
	float E2 = E1;
	if (E1 > KS)
	{
		float T = (E1 - KS) / (1. - KS);
		float Tsquared = T * T;
		float Tcubed = Tsquared * T;
		float P = (2. * Tcubed - 3. * Tsquared + 1.) * KS + (Tcubed - 2. * Tsquared + T) * (1. - KS) + (-2. * Tcubed + 3. * Tsquared) * maxLum;
		E2 = P;
	}
	return E2 * Lw_pq;
}

float3 maxRGB_eetf_linear_to_linear(float3 rgb_linear, float Lw, float Lmax)
{
	float maxRGB1_linear = max(max(rgb_linear.r, rgb_linear.g), rgb_linear.b);
	float maxRGB1_pq = linear_to_st2084_channel(maxRGB1_linear);
	float maxRGB2_pq = eetf_0_Lmax(maxRGB1_pq, Lw, Lmax);
	float maxRGB2_linear = st2084_to_linear_channel(maxRGB2_pq);
	maxRGB1_linear = max(6.10352e-5, maxRGB1_linear);
	return rgb_linear * (maxRGB2_linear / maxRGB1_linear);
}

float linear_to_hlg_channel(float u)
{
	float ln2_i = 1. / log(2.);
	float m = 0.17883277 / ln2_i;
	return (u <= (1. / 12.)) ? sqrt(3. * u) : ((log2((12. * u) - 0.28466892) * m) + 0.55991073);
}

float3 linear_to_hlg(float3 rgb, float Lw)
{
	rgb = saturate(rgb);

	if (Lw > 1000.)
	{
		rgb = maxRGB_eetf_linear_to_linear(rgb, Lw, 1000.);
		rgb *= 10000. / Lw;
	}
	else
	{
		rgb *= 10.;
	}

	float Yd = dot(rgb, float3(0.2627, 0.678, 0.0593));
	Yd = max(6.10352e-5, Yd);

	rgb *= pow(Yd, -1. / 6.);
	return float3(linear_to_hlg_channel(rgb.r), linear_to_hlg_channel(rgb.g), linear_to_hlg_channel(rgb.b));
}

// OBS linear (709_EXTENDED, 1.0 = SDR white) -> HLG non-linear signal E' (BT.2020)
float3 hlg_signal(float3 rgb)
{
	rgb *= sdr_white_nits_over_maximum;
	rgb = rec709_to_rec2020(rgb);
	return linear_to_hlg(rgb, hdr_lw);
}

float4 PSConvertRGB_HLG(VertInOut vert_in) : TARGET
{
	float4 px = image.Sample(cnv_sampler, vert_in.uv);
	float3 e = hlg_signal(px.rgb);
	float3 code = saturate(e * y_scale + y_offset);
	return float4(code, px.a > 0.0 ? 1.0 : 0.0);
}

float4 PSConvertRGB_YUV2020_HLG(VertInOut vert_in) : TARGET
{
	float4 px = image.Sample(cnv_sampler, vert_in.uv);
	float3 e = hlg_signal(px.rgb);
	float y = dot(e, float3(0.2627, 0.6780, 0.0593));
	float cb = (e.b - y) / 1.8814;
	float cr = (e.r - y) / 1.4746;
	float4 vyu;
	vyu.x = saturate(cr * c_scale + 512.0 / 1023.0); // V
	vyu.y = saturate(y * y_scale + y_offset);        // Y
	vyu.z = saturate(cb * c_scale + 512.0 / 1023.0); // U
	vyu.a = 1.0;
	return vyu;
}

technique ConvertRGB_YUV601
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSConvertRGB_YUV601(vert_in);
	}
}

technique ConvertRGB_YUV709
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSConvertRGB_YUV709(vert_in);
	}
}

technique ConvertRGB_HLG
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSConvertRGB_HLG(vert_in);
	}
}

technique ConvertRGB_YUV2020_HLG
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSConvertRGB_YUV2020_HLG(vert_in);
	}
}
