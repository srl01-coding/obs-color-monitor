uniform float4x4 ViewProj;
uniform texture2d image;
uniform float3 hi_max;
// Texture size in texels (bins, 1). See waveform.effect: when the histogram is
// drawn narrower than its bin count, each screen column takes the maximum over
// the bins it covers so single-bin spikes cannot disappear.
uniform float2 image_size = {256.0, 1.0};
uniform float4x4 color = {
	1.00, 0.41, 0.41, 0.0,
	0.00, 1.00, 0.00, 0.0,
	0.53, 0.53, 1.00, 0.0,
	0.00, 0.00, 0.00, 1.0
};

sampler_state def_sampler {
	Filter   = Point;
	AddressU = Repeat;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

// Exact texel fetch of bin at coordinate u (wrapped for parade panels).
float4 load_bin(float u)
{
	float x = min(floor(frac(u) * image_size.x), image_size.x - 1.0);
	return image.Load(int3(int(x), 0, 0));
}

// Maximum over the bins covered by one screen column. du = |d u / d screen-x|.
float4 sample_max_u(float u, float du)
{
	float bins = du * image_size.x;
	float4 m = load_bin(u);
	if (bins > 1.0) {
		float n = min(ceil(bins), 32.0);
		float step = du / n;
		float uk = u - 0.5 * du + 0.5 * step;
		float u_lo = floor(u);
		float k = 0.0;
		do {
			m = max(m, load_bin(clamp(uk, u_lo, u_lo + 0.99999)));
			uk += step;
			k += 1.0;
		} while (k < n);
	}
	return m;
}

float4 PSDrawOverlay(VertInOut vert_in) : TARGET
{
	float4 rgb;
	rgb.xyz = sample_max_u(vert_in.uv.x, abs(ddx(vert_in.uv.x))).xyz;
	if (rgb.x >= (1-vert_in.uv.y) * hi_max.x) rgb.x=1.0; else rgb.x=0.0;
	if (rgb.y >= (1-vert_in.uv.y) * hi_max.y) rgb.y=1.0; else rgb.y=0.0;
	if (rgb.z >= (1-vert_in.uv.y) * hi_max.z) rgb.z=1.0; else rgb.z=0.0;
	rgb.a = 1.0;
	return rgb;
}

float4 PSDrawStack(VertInOut vert_in) : TARGET
{
	int i = int(vert_in.uv.y * 3);
	float v = vert_in.uv.y * 3 - i;
	float r = sample_max_u(vert_in.uv.x, abs(ddx(vert_in.uv.x)))[i];
	if (r >= (1-v) * hi_max[i]) r=1.0; else r=0.0;
	return float4(color[i].xyz*r, 1.0);
}

float4 PSDrawParade(VertInOut vert_in) : TARGET
{
	int i = int(vert_in.uv.x * 3);
	float r = sample_max_u(vert_in.uv.x*3, abs(ddx(vert_in.uv.x))*3.0)[i];
	if (r >= (1-vert_in.uv.y) * hi_max[i]) r=1.0; else r=0.0;
	return float4(color[i].xyz*r, 1.0);
}

float4 PSDrawStackUV(VertInOut vert_in) : TARGET
{
	int i;
	float v;
	if (vert_in.uv.y < 0.5) {
		i = 0;
		v = vert_in.uv.y * 2;
	}
	else {
		i = 2;
		v = vert_in.uv.y * 2 - 1;
	}
	float r = sample_max_u(vert_in.uv.x, abs(ddx(vert_in.uv.x)))[i];
	if (r >= (1-v) * hi_max[i]) r=1.0; else r=0.0;
	return float4(color[i].xyz*r, 1.0);
}

float4 PSDrawParadeUV(VertInOut vert_in) : TARGET
{
	int i;
	if (vert_in.uv.x < 0.5)
		i = 0;
	else
		i = 2;
	float r = sample_max_u(vert_in.uv.x*2, abs(ddx(vert_in.uv.x))*2.0)[i];
	if (r >= (1-vert_in.uv.y) * hi_max[i]) r=1.0; else r=0.0;
	return float4(color[i].xyz*r, 1.0);
}

technique DrawOverlay
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawOverlay(vert_in);
	}
}

technique DrawStack
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawStack(vert_in);
	}
}

technique DrawParade
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawParade(vert_in);
	}
}

technique DrawStackUV
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawStackUV(vert_in);
	}
}

technique DrawParadeUV
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawParadeUV(vert_in);
	}
}
