uniform float4x4 ViewProj;
uniform texture2d image;
uniform bool use_lut;
uniform texture2d lut;
// HLG mode: image holds HLG R'G'B' as code/1023 (common.effect ConvertRGB_HLG);
// E' = (v - hlg_y_offset) / hlg_y_scale. The key gradient is drawn with 1 / 0.
uniform float hlg_y_scale = 1.0;
uniform float hlg_y_offset = 0.0;

sampler_state def_sampler {
	Filter   = Linear;
	AddressU = Clamp;
	AddressV = Clamp;
};

sampler_state lut_sampler {
	Filter   = Point;
	AddressU = Clamp;
	AddressV = Clamp;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

float4 PSDrawFalseColor601(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	float y = dot(rgba.xyz, float3(0.299000, 0.587000, 0.114000));

	if (use_lut)
		return lut.Sample(lut_sampler, float2(y, 0.5));
	else if (y < 0.02)
		return float4(0.85, 0.22, 1.0, 1.0); // bright purple
	else if (y < 0.10)
		return float4(0.0, 0.0, 1.0, 1.0); // blue
	else if (y < 0.20)
		return float4(0.33, 0.55, 1.0, 1.0); // light blue
	else if (y < 0.42)
		return float4(0.3, 0.3, 0.3, 1.0); // dark grey
	else if (y < 0.48)
		return float4(0.6, 1.0, 0.0, 1.0); // green
	else if (y < 0.52)
		return float4(0.5, 0.5, 0.5, 1.0); // medium grey
	else if (y < 0.58)
		return float4(0.95, 0.62, 0.62, 1.0); // pink
	else if (y < 0.78)
		return float4(0.7, 0.7, 0.7, 1.0); // light grey
	else if (y < 0.84)
		return float4(0.7, 0.7, 0.0, 1.0); // dark yellow
	else if (y < 0.94)
		return float4(1.0, 1.0, 0.0, 1.0); // yellow
	else if (y < 1.00)
		return float4(0.9, 0.5, 0.0, 1.0); // orange
	else
		return float4(0.9, 0.2, 0.0, 1.0); // red
}

float4 PSDrawFalseColor709(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	float y = dot(rgba.xyz, float3(0.212600, 0.715200, 0.072200));

	if (use_lut)
		return lut.Sample(lut_sampler, float2(y, 0.5));
	else if (y < 0.02)
		return float4(0.85, 0.22, 1.0, 1.0); // bright purple
	else if (y < 0.10)
		return float4(0.0, 0.0, 1.0, 1.0); // blue
	else if (y < 0.20)
		return float4(0.33, 0.55, 1.0, 1.0); // light blue
	else if (y < 0.42)
		return float4(0.3, 0.3, 0.3, 1.0); // dark grey
	else if (y < 0.48)
		return float4(0.6, 1.0, 0.0, 1.0); // green
	else if (y < 0.52)
		return float4(0.5, 0.5, 0.5, 1.0); // medium grey
	else if (y < 0.58)
		return float4(0.95, 0.62, 0.62, 1.0); // pink
	else if (y < 0.78)
		return float4(0.7, 0.7, 0.7, 1.0); // light grey
	else if (y < 0.84)
		return float4(0.7, 0.7, 0.0, 1.0); // dark yellow
	else if (y < 0.94)
		return float4(1.0, 1.0, 0.0, 1.0); // yellow
	else if (y < 1.00)
		return float4(0.9, 0.5, 0.0, 1.0); // orange
	else
		return float4(0.9, 0.2, 0.0, 1.0); // red
}

/* HLG signal bands (BT.2100 HLG, BT.2020 luma; levels from Report ITU-R BT.2408 Tables 1-2,
 * nits for a 1000 cd/m2 display):
 *   <2 purple (crushed)   2-10 blue   10-20 light blue   20-36 dark grey
 *   36-40 green (18% grey card, 38%)   40-55 mid grey   55-65 pink (light skin, Type 1-2)
 *   65-73 light grey   73-77 cyan (HDR reference / graphics white, 75% = 203 nits)
 *   77-87 dark yellow (230-430 nits)   87-95 yellow (430-720)   95-100 orange (720-1000)
 *   >100 red (super-white: narrow-range codes above 940, beyond the nominal peak) */
float4 hlg_band(float y)
{
	if (y < 0.02)
		return float4(0.85, 0.22, 1.0, 1.0); // bright purple
	else if (y < 0.10)
		return float4(0.0, 0.0, 1.0, 1.0); // blue
	else if (y < 0.20)
		return float4(0.33, 0.55, 1.0, 1.0); // light blue
	else if (y < 0.36)
		return float4(0.3, 0.3, 0.3, 1.0); // dark grey
	else if (y < 0.40)
		return float4(0.6, 1.0, 0.0, 1.0); // green
	else if (y < 0.55)
		return float4(0.5, 0.5, 0.5, 1.0); // medium grey
	else if (y < 0.65)
		return float4(0.95, 0.62, 0.62, 1.0); // pink
	else if (y < 0.73)
		return float4(0.7, 0.7, 0.7, 1.0); // light grey
	else if (y < 0.77)
		return float4(0.0, 0.85, 0.85, 1.0); // cyan
	else if (y < 0.87)
		return float4(0.7, 0.7, 0.0, 1.0); // dark yellow
	else if (y < 0.95)
		return float4(1.0, 1.0, 0.0, 1.0); // yellow
	else if (y <= 1.0006) // half a 10-bit narrow-range code above 940
		return float4(0.9, 0.5, 0.0, 1.0); // orange
	else
		return float4(0.9, 0.2, 0.0, 1.0); // red
}

float4 PSDrawFalseColorHLG(VertInOut vert_in) : TARGET
{
	float4 rgba = image.Sample(def_sampler, vert_in.uv);
	float3 e = (rgba.rgb - hlg_y_offset) / hlg_y_scale;
	float y = dot(e, float3(0.2627, 0.6780, 0.0593));

	if (use_lut)
		return lut.Sample(lut_sampler, float2(saturate(y), 0.5));
	return hlg_band(y);
}

technique DrawFalseColor601
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawFalseColor601(vert_in);
	}
}
technique DrawFalseColor709
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawFalseColor709(vert_in);
	}
}
technique DrawFalseColorHLG
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawFalseColorHLG(vert_in);
	}
}
