uniform float4x4 ViewProj;
uniform texture2d image;
uniform float intensity;
// Texture size in texels (width, rows). Used to keep thin traces visible when
// the scope is displayed smaller than its native size: every screen pixel
// takes the maximum over all texel rows it covers instead of one sample.
uniform float2 image_size = {256.0, 256.0};
uniform float4x4 color = {
	1.00, 0.41, 0.41, 0.0,
	0.00, 1.00, 0.00, 0.0,
	0.53, 0.53, 1.00, 0.0,
	0.00, 0.00, 0.00, 1.0
};

sampler_state def_sampler {
	Filter   = Point;
	AddressU = Repeat;
	AddressV = Repeat;
};

struct VertInOut {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertInOut VSDefault(VertInOut vert_in)
{
	VertInOut vert_out;
	vert_out.pos = mul(float4(vert_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = vert_in.uv;
	return vert_out;
}

// Exact texel fetch (no gradients, so it is legal inside a dynamic loop).
// u, v may lie outside [0,1) by whole units (stack/parade panels): wrap them.
float4 load_uv(float u, float v)
{
	float x = min(floor(frac(u) * image_size.x), image_size.x - 1.0);
	float y = min(floor(frac(v) * image_size.y), image_size.y - 1.0);
	return image.Load(int3(int(x), int(y), 0));
}

// Maximum over the texel rows covered by one screen pixel at (u, v), so a
// one-row trace cannot disappear when the scope is drawn smaller than its
// native size. dv = |d v / d screen-y| in texture coordinates.
float4 sample_max_v(float u, float v, float dv)
{
	float rows = dv * image_size.y;
	float4 m = load_uv(u, v);
	if (rows > 1.0) {
		float n = min(ceil(rows), 32.0);
		float step = dv / n;
		float vk = v - 0.5 * dv + 0.5 * step;
		// stay inside the current panel
		float v_lo = floor(v);
		float k = 0.0;
		do {
			m = max(m, load_uv(u, clamp(vk, v_lo, v_lo + 0.99999)));
			vk += step;
			k += 1.0;
		} while (k < n);
	}
	return m;
}

float4 PSDrawOverlay(VertInOut vert_in) : TARGET
{
	float4 rgb;
	rgb.xyz = sample_max_v(vert_in.uv.x, vert_in.uv.y, abs(ddy(vert_in.uv.y))).xyz * intensity;
	if (rgb.x>1.0) rgb.x = 1.0;
	if (rgb.y>1.0) rgb.y = 1.0;
	if (rgb.z>1.0) rgb.z = 1.0;
	rgb.a = 1.0;
	return rgb;
}

float4 PSDrawStack(VertInOut vert_in) : TARGET
{
	int i = int(vert_in.uv.y * 3);
	float v = vert_in.uv.y * 3 - i;
	float r = sample_max_v(vert_in.uv.x, v, abs(ddy(vert_in.uv.y)) * 3.0)[i] * intensity;
	if (r>1.0) r = 1.0;
	return float4(color[i].xyz*r, 1.0);
}

float4 PSDrawParade(VertInOut vert_in) : TARGET
{
	int i = int(vert_in.uv.x * 3);
	float u = vert_in.uv.x * 3 - i;
	float r = sample_max_v(u, vert_in.uv.y, abs(ddy(vert_in.uv.y)))[i] * intensity;
	if (r>1.0) r = 1.0;
	return float4(color[i].xyz*r, 1.0);
}

float4 PSDrawStackUV(VertInOut vert_in) : TARGET
{
	int i;
	if (vert_in.uv.y < 0.5)
		i = 0;
	else
		i = 2;
	float v = vert_in.uv.y * 2;
	float r = sample_max_v(vert_in.uv.x, v, abs(ddy(vert_in.uv.y)) * 2.0)[i] * intensity;
	if (r>1.0) r = 1.0;
	return float4(color[i].xyz*r, 1.0);
}

float4 PSDrawParadeUV(VertInOut vert_in) : TARGET
{
	int i;
	if (vert_in.uv.x < 0.5)
		i = 0;
	else
		i = 2;
	float u = vert_in.uv.x * 2;
	float r = sample_max_v(u, vert_in.uv.y, abs(ddy(vert_in.uv.y)))[i] * intensity;
	if (r>1.0) r = 1.0;
	return float4(color[i].xyz*r, 1.0);
}

technique DrawOverlay
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawOverlay(vert_in);
	}
}

technique DrawStack
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawStack(vert_in);
	}
}

technique DrawParade
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawParade(vert_in);
	}
}

technique DrawStackUV
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawStackUV(vert_in);
	}
}

technique DrawParadeUV
{
	pass
	{
		vertex_shader = VSDefault(vert_in);
		pixel_shader  = PSDrawParadeUV(vert_in);
	}
}
